DATABASE_URL=postgresql+asyncpg://pitchside:pitchside@localhost:5433/pitchside

# Comma-separated frontend origins allowed by CORS.
# Defaults to the Vite dev server; set to the deployed frontend origin in prod.
CORS_ORIGINS=http://localhost:5173

# ETL data source. Default "api" loads the real API-Football-backed tournament
# from the committed cache (backend/etl/seed/raw_cache/, offline). Set to "seed"
# only for the legacy fabricated seed used in local design work.
ETL_SOURCE=api

# API-Football (api-sports.io). Only needed to refresh the cache via
# `python -m etl.pull_raw`; the committed cache means the ETL runs without it.
# Get key: https://dashboard.api-football.com  (header: x-apisports-key)
API_FOOTBALL_KEY=your_api_football_key_here
